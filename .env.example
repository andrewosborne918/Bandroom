# Vercel production and preview must use DIFFERENT Supabase projects.
APP_PLATFORM=supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SECRET
APP_ORIGIN=https://YOUR_DOMAIN
NEXT_PUBLIC_GOOGLE_LOGIN=false
APP_ENV=production
# Worker-only scoped credentials, never Supabase admin keys in worker containers.
WORKER_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
CRON_SECRET=GENERATE_A_DIFFERENT_32_BYTE_SECRET
ALERT_WEBHOOK_URL=https://YOUR_PRIVATE_ALERT_RECEIVER
# Comma-separated verified Supabase user IDs. No customer audio access is granted.
APPLICATION_OWNER_IDS=YOUR_AUTH_USER_UUID
# Required for repeatable Vercel CI deployment, stored as GitHub Actions secrets.
VERCEL_TOKEN=YOUR_VERCEL_TOKEN
VERCEL_ORG_ID=YOUR_VERCEL_TEAM_ID
VERCEL_PROJECT_ID=YOUR_VERCEL_PROJECT_ID
# Backup automation only. Use independent encrypted private S3 destinations.
BACKUP_S3_ENDPOINT=https://YOUR_PRIVATE_BACKUP_STORAGE
BACKUP_S3_BUCKET=YOUR_BACKUP_BUCKET
BACKUP_ACCESS_KEY_ID=YOUR_BACKUP_KEY
BACKUP_SECRET_ACCESS_KEY=YOUR_BACKUP_SECRET
DATABASE_URL=YOUR_SERVER_DATABASE_CONNECTION_STRING
# Optional app invitation delivery; auth email uses Supabase custom SMTP separately.
RESEND_API_KEY=OPTIONAL_SERVER_ONLY_RESEND_KEY
EMAIL_FROM=Bndrm <invites@YOUR_VERIFIED_DOMAIN>
# Optional music catalog recognition. Keep the provider token server-only.
AUDD_API_TOKEN=YOUR_AUDD_API_TOKEN
RECOGNITION_ENABLED=true
RECOGNITION_MONTHLY_CAP=10000

# Private audio uses your own Cloudflare R2 bucket. Server-only credentials.
AUDIO_STORAGE=r2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=bandroom-audio
R2_ACCESS_KEY_ID=SERVER_ONLY_ACCESS_KEY
R2_SECRET_ACCESS_KEY=SERVER_ONLY_SECRET
